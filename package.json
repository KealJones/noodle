{
  "name": "noodle",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "An assistant that understands and acts without a language model, built as a graph of nested concepts (N-Con).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test 'dist/**/*.test.js'",
    "test:capture": "node --test scripts/capture.test.mjs",
    "serve": "pnpm build && node dist/serve/cli.js serve",
    "seed:count": "pnpm build && node dist/seed/count.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}
