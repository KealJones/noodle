// Seed part 3: the bridge (design section 6; built-ins.md section 3).
//
// Patterns of core meanings to primitives. Without it, import alone reaches no primitive. Every
// pattern here is made of core meanings (seed/core.ncon) and structural concepts only, and every
// becomes is a primitive (built-ins.md section 2). No entry names a domain command: a command is
// always learned from its documentation, through the one general entry at the end.
//
// Primitives take their arguments in the order of built-ins.md section 2. An acting reading
// declares its effects and checks (ncon.md section 4); they narrow the primitive's own.
// Results are reported with and without this part (design section 6).

Pack(name="seed-bridge", version="0.1.0", from=Seed("bridge"))

// ---------------------------------------------------------------------------------------------
// Holding

// Cause something to be in a holder: Store (ChangesGraph for a holder in the graph, the primitive's).
Reading(on=Store(), pattern=Cause(result=Become(BeIn($x, $h))),
  becomes=Store($h, $x), checks=Contains($h, $x))

// Cause a holder to have something: Store.
Reading(on=Store(), pattern=Cause(result=Become(Have($h, $x))),
  becomes=Store($h, $x), checks=Contains($h, $x))

// Cause something to stop being in a holder: Remove. Its effect class is the primitive's, from
// the holder: taking out of a holder in the graph what the user put in retracts a fact, which loses
// nothing and Store restores, so it is ChangesGraph (built-ins.md section 2), not Deletes.
Reading(on=Remove(), pattern=Cause(result=Become(Not(BeIn($x, $h)))),
  becomes=Remove($h, $x), checks=Not(Contains($h, $x)))

Reading(on=Remove(), pattern=Cause(result=Become(Not(Have($h, $x)))),
  becomes=Remove($h, $x), checks=Not(Contains($h, $x)))

// Putting a number into a number, or taking one out of it, is adding or subtracting ("add 5 to
// 10", "subtract 3 from 10", "add 45 and 38"): the answer is its value.
Reading(on=Arithmetic(), pattern=Cause(result=Become(BeIn($x, $h))), wants=All(IsA($x, Number()), IsA($h, Number())),
  becomes=Question(Arithmetic(Addition(), $h, $x), about=Gap()))
Reading(on=Arithmetic(), pattern=Cause(result=Become(Not(BeIn($x, $h)))), wants=All(IsA($x, Number()), IsA($h, Number())),
  becomes=Question(Arithmetic(Subtraction(), $h, $x), about=Gap()))

// Cause something to stop existing: Remove it from where it is.
Reading(on=Remove(), pattern=Cause(result=Become(Not(Exist($x)))), needs=BeIn($x, $h),
  becomes=Remove($h, $x), checks=Not(Contains($h, $x)))

Reading(on=Remove(), pattern=Cause(result=End($x)), wants=IsA($x, Thing()), needs=BeIn($x, $h),
  becomes=Remove($h, $x), checks=Not(Contains($h, $x)))

// Move something from one holder to another: Remove from the source, then Store at the destination.
Reading(on=Sequence(), pattern=Move(theme=$x, source=$s, destination=$d),
  becomes=Sequence(Remove($s, $x), Store($d, $x)), effects=All(Deletes(), ChangesLocal()),
  checks=All(Not(Contains($s, $x)), Contains($d, $x)))

// Is something in a holder: Contains, pure.
Reading(on=Contains(), pattern=BeIn($x, $h), becomes=Contains($h, $x))
Reading(on=Contains(), pattern=Have($h, $x), becomes=Contains($h, $x))

// ---------------------------------------------------------------------------------------------
// Properties

// Cause something to come to have a value for a property: Set. "X is V in respect of P" is
// Be(X, V, attribute=P).
Reading(on=Set(), pattern=Cause(result=Become(Be($x, $v, attribute=$p))),
  becomes=Set($x, $p, $v), effects=ChangesLocal(), checks=Be($x, $v, attribute=$p))

Reading(on=Set(), pattern=Change(theme=$x, result=Be($x, $v, attribute=$p)),
  becomes=Set($x, $p, $v), effects=ChangesLocal(), checks=Be($x, $v, attribute=$p))

// ---------------------------------------------------------------------------------------------
// Knowing and saying

// Cause the speaker to know or see something: Say it.
Reading(on=Say(), pattern=Cause(result=Become(Know(experiencer=Speaker(), theme=$x))),
  becomes=Say($x), effects=Speaks())

Reading(on=Say(), pattern=Cause(result=See(experiencer=Speaker(), stimulus=$x)),
  becomes=Say($x), effects=Speaks())
// Showing or telling the speaker something that is read (a file, a page) is reading it to them;
// which of the two is meant is the score's, by whether the thing can be read.
Reading(on=Read(), pattern=Cause(result=See(experiencer=Speaker(), stimulus=$x)), becomes=Read($x))
Reading(on=Read(), pattern=Cause(result=Become(Know(experiencer=Speaker(), theme=$x))), becomes=Read($x))
// The assistant making something seen, with no one named to see it ("show the log", and a tool's
// own "Show the working tree status"), shows it to whoever it is talking to.
Reading(on=Say(), pattern=Cause(agent=Addressee(), result=Become(See(stimulus=$x))), becomes=Say($x), effects=Speaks())
Reading(on=Read(), pattern=Cause(agent=Addressee(), result=Become(See(stimulus=$x))), becomes=Read($x))
// Asking to be told something is asking what it is ("tell me your name": what is your name).
Reading(on=Question(), pattern=Cause(result=Become(Know(experiencer=Speaker(), theme=$x))), becomes=Question(Be(Gap(), $x), about=Gap()))
Reading(on=Question(), pattern=Directive(Question($q, about=$a)), becomes=Question($q, about=$a))

// The assistant saying something: Say.
Reading(on=Say(), pattern=Say(agent=Addressee(), theme=$x), becomes=Say($x), effects=Speaks())
Reading(on=Say(), pattern=Answer(agent=Addressee(), theme=$x), becomes=Say($x), effects=Speaks())

// The assistant coming to know or see something: Read it.
Reading(on=Read(), pattern=Cause(result=Become(Know(experiencer=Addressee(), theme=$x))), becomes=Read($x))
Reading(on=Read(), pattern=See(experiencer=Addressee(), stimulus=$x), becomes=Read($x))
Reading(on=Read(), pattern=Try(theme=See(experiencer=Addressee(), stimulus=$x)), becomes=Read($x))

// Asking what is in a holder is looking in it: Read it ("what's in the fridge", "what is in X").
Reading(on=Read(), pattern=Question(BeIn(Gap(), $h), about=Gap()), becomes=Question(Read($h), about=Gap()))
Reading(on=Read(), pattern=Question(And(BeIn(Gap(), $h), $k), about=Gap()), becomes=Question(Read($h), about=Gap()))
Reading(on=Read(), pattern=Question(Contains($h, Gap()), about=Gap()), becomes=Question(Read($h), about=Gap()))
// Here, for the assistant, is the workspace it works in, which Read knows as "." (its root).
// What is here is what is in it; the place we are in is here, and asking which place that is
// asks where it is ("what's in here", "where are we", "what folder are we in").
Reading(on=Here(), pattern=Read(Here()), becomes=Read("."))
Reading(on=Here(), pattern=BeIn(And(Speaker(), Addressee()), $p), becomes=Be($p, Here()))
Reading(on=Here(), pattern=Be(agent=And(Speaker(), Addressee()), location=$p), becomes=Be($p, Here()))
Reading(on=Here(), pattern=BeIn(Speaker(), $p), becomes=Be($p, Here()))
Reading(on=Here(), pattern=Be(agent=Speaker(), location=$p), becomes=Be($p, Here()))
Reading(on=Read(), pattern=Question(And(Be(Gap(), Here()), $k), about=Gap()), becomes=Question(Read(Here()), about=Place()))
// Asking what a named thing is can be looking at it, when it is something that can be read.
Reading(on=Read(), pattern=Question(Be(Gap(), $x), about=Gap()), becomes=Question(Read($x), about=Gap()))

// The assistant asking: Ask.
Reading(on=Ask(), pattern=Cause(result=Become(Know(experiencer=Addressee(), theme=$x))), wants=IsA($x, Prop()),
  becomes=Ask($x), effects=Speaks())

// Something the assistant should keep knowing about the user or the world: Remember.
Reading(on=Remember(), pattern=Continue(theme=Know(experiencer=Addressee(), theme=$p)),
  becomes=Remember($p), effects=ChangesGraph(), checks=Know(experiencer=Addressee(), theme=$p))

// ---------------------------------------------------------------------------------------------
// Making and changing documents

// Cause a document to exist: Write it, with content the assistant writes (Written, the genres).
Reading(on=Write(), pattern=Cause(result=Become(Exist($d))), wants=IsA($d, Document()),
  becomes=Write($d, Written($d)), effects=ChangesLocal(), checks=Contains($d, Written($d)))

Reading(on=Write(), pattern=Make(product=$d), wants=IsA($d, Document()),
  becomes=Write($d, Written($d)), effects=ChangesLocal(), checks=Contains($d, Written($d)))

// Cause a document to contain something: Edit it.
Reading(on=Edit(), pattern=Cause(result=Become(BeIn($x, $d))), wants=IsA($d, Document()),
  becomes=Edit($d, Inserted($x)), effects=ChangesLocal(), checks=Contains($d, $x))

// Cause a document to stop containing something: Edit it.
Reading(on=Edit(), pattern=Cause(result=Become(Not(BeIn($x, $d)))), wants=IsA($d, Document()),
  becomes=Edit($d, Withdrawn($x)), effects=ChangesLocal(), checks=Not(Contains($d, $x)))

// Change a document: Edit it.
Reading(on=Edit(), pattern=Change(theme=$d, result=$p), wants=IsA($d, Document()),
  becomes=Edit($d, $p), effects=ChangesLocal(), checks=$p)

// Cause a part of a document to be other: Edit it.
Reading(on=Edit(), pattern=Cause(result=Become(Other($x, $y))), needs=PartOf($x, $d), wants=IsA($d, Document()),
  becomes=Edit($d, And(Withdrawn($x), Inserted($y))), effects=ChangesLocal(), checks=Contains($d, $y))

// ---------------------------------------------------------------------------------------------
// Counting, choosing, ordering (pure)

Reading(on=Count(), pattern=Number($s), becomes=Count($s))
Reading(on=Count(), pattern=Amount($s), becomes=Count($s))
Reading(on=Rank(), pattern=Most($k, attribute=$a), becomes=Rank($k, $a))
Reading(on=Sort(), pattern=Order($s, attribute=$a), becomes=Sort($s, $a))
Reading(on=Filter(), pattern=Every($k, where=$p), becomes=Filter($k, $p))
Reading(on=Compare(), pattern=Same($a, $b), becomes=Compare($a, $b, Same()))
Reading(on=Compare(), pattern=More($a, standard=$b, attribute=$k), becomes=Compare($a, $b, $k))
Reading(on=Compare(), pattern=Less($a, standard=$b, attribute=$k), becomes=Compare($b, $a, $k))
Reading(on=Now(), pattern=Now(), becomes=Now())
// Asking which time it is now is reading the clock. The kind asked for (a time of day, a day) is
// kept as what the question is about, so the answer is said as that kind.
Reading(on=Now(), pattern=Question(Be(Gap(), $k, time=Now()), about=Gap()), becomes=Question(Now(), about=$k))

// Asking what a computation is, or saying one on its own ("17 * 23"), asks for its value. Its
// value is a number.
Concept(Arithmetic(), IsA(Number()))
Reading(on=Arithmetic(), pattern=Question(Be(Gap(), Arithmetic($o, $a, $b)), about=Gap()), becomes=Question(Arithmetic($o, $a, $b), about=Gap()))
Reading(on=Arithmetic(), pattern=Assert(Be(Ref(said=$s, kind=Thing()), Arithmetic($o, $a, $b))), becomes=Question(Arithmetic($o, $a, $b), about=Gap()))

// ---------------------------------------------------------------------------------------------
// Time

// Do something at a later time: Schedule it.
Reading(on=Schedule(), pattern=Do(theme=$a, time=After($t)), wants=IsA($t, Time()),
  becomes=Schedule($t, $a), effects=ChangesLocal())

Reading(on=Schedule(), pattern=Wait(agent=Addressee(), time=Until($t)), wants=IsA($t, Time()),
  becomes=Schedule($t, Now()), effects=ChangesLocal())

// Telling of an act still to come, at a later time ("remind me tomorrow to call mom": cause me to
// know it then): Schedule the saying of it, in the words it was asked in.
Reading(on=Schedule(), pattern=Say(Future($x), time=$t), becomes=Schedule($t, Say($x)), effects=ChangesLocal())
// What the assistant will say later is what is scheduled ("what will you remind me about").
Reading(on=Read(), pattern=Question(Say(Gap(), time=Future()), about=Gap()), becomes=Question(Read(Schedule()), about=Gap()))

// ---------------------------------------------------------------------------------------------
// Doing in order

Reading(on=Sequence(), pattern=Then($a, $b), becomes=Sequence($a, $b))
Reading(on=Sequence(), pattern=And($a, $b), wants=All(IsA($a, Act()), IsA($b, Act())), becomes=Sequence($a, $b))
Reading(on=Sequence(), pattern=Again($a), becomes=Sequence($a))

// Working out what would happen without doing it: Suppose.
Reading(on=Suppose(), pattern=Question(Happen(theme=$e), about=Gap()), wants=IsA($e, Act()), becomes=Suppose($e))
Reading(on=Suppose(), pattern=Maybe(Happen(theme=$e)), wants=IsA($e, Act()), becomes=Suppose($e))

// ---------------------------------------------------------------------------------------------
// VerbNet's predicates (design section 6: the bridge maps "VerbNet predicates and frames"). The
// VerbNet import keeps a verb's semantics in VerbNet's own predicates; these say which core
// meanings they are. Predicates not here stay VerbNet's and do not reduce.

Concept(HasLocation())
Concept(HasPossession())
Concept(HasState())
Concept(Motion())
Concept(Transfer())
Concept(TransferInfo())
Concept(Perceive())
Concept(Appear())
Concept(Contact())
Concept(Utilize())
Concept(Desire())
Concept(Destroyed())
Concept(HasAttribute())
Concept(HasInformation())
Concept(Function())
Concept(Understand())
Concept(Contain())
Concept(Occur())
Concept(Search())
Concept(Declare())
Concept(Indicate())
Concept(Benefit())
Concept(InReactionTo())

Reading(on=HasLocation(), pattern=HasLocation($x, $y), becomes=BeIn($x, $y))
Reading(on=Location(), pattern=Location($x, $y), becomes=BeIn($x, $y))
Reading(on=HasPossession(), pattern=HasPossession($h, $x), becomes=Have($h, $x))
Reading(on=HasState(), pattern=HasState($x, $v), becomes=Be($x, $v))
Reading(on=HasAttribute(), pattern=HasAttribute($x, $a, $v), becomes=Be($x, $v, attribute=$a))
Reading(on=Motion(), pattern=Motion($x), becomes=Move(theme=$x))
Reading(on=Motion(), pattern=Motion($x, $path), becomes=Move(theme=$x, path=$path))
Reading(on=Transfer(), pattern=Transfer($a, $t, $r), becomes=Cause(agent=$a, result=Become(Have($r, $t))))
Reading(on=TransferInfo(), pattern=TransferInfo($a, $t, $r), becomes=Say(agent=$a, theme=$t, recipient=$r))
Reading(on=Perceive(), pattern=Perceive($e, $x), becomes=See(experiencer=$e, stimulus=$x))
// Appearing is coming to be seen, by no one named (reflexive_appearance-48.1.2: "show the log").
Reading(on=Appear(), pattern=Appear($x), becomes=See(stimulus=$x))
Reading(on=Contact(), pattern=Contact($x, $y), becomes=Touch($x, $y))
Reading(on=Utilize(), pattern=Utilize($a, $x), becomes=Use(agent=$a, theme=$x))
Reading(on=Desire(), pattern=Desire($e, $x), becomes=Want(experiencer=$e, theme=$x))
Reading(on=Destroyed(), pattern=Destroyed($x), becomes=Not(Exist($x)))
Reading(on=HasInformation(), pattern=HasInformation($e, $x), becomes=Know(experiencer=$e, theme=$x))
// VerbNet's function (function-105.2.1, "the machine runs") is working: doing what it is for.
Reading(on=Function(), pattern=Function($x), becomes=Work(theme=$x))
Reading(on=Understand(), pattern=Understand($e, $x), becomes=Know(experiencer=$e, theme=$x))
Reading(on=Contain(), pattern=Contain($h, $x), becomes=BeIn($x, $h))
Reading(on=Occur(), pattern=Occur($e), becomes=Happen($e))
Reading(on=Search(), pattern=Search($a, $l, $x), becomes=Try(agent=$a, theme=See(experiencer=$a, stimulus=$x), location=$l))
Reading(on=Declare(), pattern=Declare($a, $x, $v), becomes=Say(agent=$a, theme=Be($x, $v)))
Reading(on=Indicate(), pattern=Indicate($x, $t), becomes=Mean($x, $t))
// VerbNet joins a predicate with one that only says who it is for or what it answers; those are
// roles of the first. The same thing said twice is said once.
Reading(on=Benefit(), pattern=And($x, Benefit($b)), becomes=WithRoles($x, beneficiary=$b))
Reading(on=InReactionTo(), pattern=And($x, InReactionTo($s)), becomes=WithRoles($x, reason=$s))
Reading(on=Same(), pattern=And($x, $x), becomes=$x)
// VerbNet's together of a thing and a list (mix-22.1: "add the eggs to the list"): the thing is in
// the list. Together with another kind of whole, it is only together with it (the want is scored).
Reading(on=Together(), pattern=Together($x, $h), wants=IsA($h, List()), becomes=BeIn($x, $h))

// ---------------------------------------------------------------------------------------------
// Tools: the one general entry (design section 6). Whatever a tool's documentation page says the
// tool does, running the tool does. Understanding a page gives Describes(program, what) with what
// reduced to core meanings, Usage(program, arguments) from its SYNOPSIS, and EffectsOf(program)
// from what the page says it changes. A request reaches this entry when its own reduction matches
// a description by the scored match (runtime.md section 6.2); the command's name is never needed.

Concept(Program())
Concept(Describes(), Frame(Program(), Prop()))
Concept(Usage(), Frame(Program(), Thing()))
Concept(EffectsOf(), Frame(Program()))

Reading(on=Run(), pattern=$what, needs=All(Describes($program, $what), Usage($program, $args)),
  becomes=Run($program, $args), effects=EffectsOf($program), checks=$what)

// Making a command or a program work is running it ("run git status", "run `pwd`").
Reading(on=Run(), pattern=Work(theme=Run($p, $a)), becomes=Run($p, $a))
Reading(on=Run(), pattern=Work(theme=$p), wants=IsA($p, Program()), becomes=Run($p, Args()))
// Reading or showing what a command gives ("show me the git log") is running it: its output is
// what is shown.
Reading(on=Run(), pattern=Read(Run($p, $a)), becomes=Run($p, $a))
Reading(on=Run(), pattern=Say(Run($p, $a)), becomes=Run($p, $a))
