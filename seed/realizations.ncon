// Seed part 8: English realizations (design sections 6, 23 and 25b).
//
// What the assistant says, as Speaking readings: the wording of each thing it says, made of
// document heads and words, never markup. Then the media realizations: how a document prints in
// markdown (the chat, .md files) and in plain text (commit messages, terminals). The medium is a
// fact on the destination, never a guess from the words.
//
// Wording: string literals are the words said; a nested expression is realized by its own
// Speaking readings, and a concept with none is said by its lemma (the last entry of section 1).
// Printing: Print(doc, medium=M) is the last step of Say; a literal prints escaped in the medium
// (content never becomes markup by accident); Printed(...) joins its parts into text;
// Escaped(s) escapes the medium's marks in s; Fenced(s, mark) wraps s in a fence of mark longer
// than any run of it inside s (structural; seed/README.md).

Pack(name="seed-realizations", version="0.1.0", from=Seed("realizations"))

// =============================================================================================
// 1. Saying a concept

// A concept with no realization of its own is said by its lemma.
Reading(on=Lemma(), mode=Speaking(), pattern=$x, needs=Fact($x, Lemma($l)), becomes=$l)

// A thing the user has in the graph is said the way they said it.
Reading(on=Said(), mode=Speaking(), pattern=$x, needs=Fact($x, Said($s)), becomes=$s)

// A referent is said the way the user said it.
Reading(on=Ref(), mode=Speaking(), pattern=Ref(said=$s), becomes=$s)

// Names of things (files, branches, commands, identifiers) are code: copyable, never stress.
Reading(on=Code(), mode=Speaking(), pattern=$x, wants=IsA($x, Name()), becomes=Code($x))

// A command line is code: the program, then its arguments, with spaces between.
// A command is said as running it ("run `git status`"); its command line is the program and
// its arguments, which is what a code block shows.
Concept(CommandLine())
Reading(on=Run(), mode=Speaking(), pattern=Run($p, $args), becomes=Paragraph("run ", Code(CommandLine($p, $args))))
Reading(on=Run(), mode=Speaking(), pattern=CommandLine($p, $args), becomes=Paragraph($p, " ", $args))
Reading(on=Run(), mode=Speaking(), pattern=CommandLine($p, Args()), becomes=$p)
Reading(on=Run(), mode=Speaking(), pattern=Args($a), becomes=$a)
Reading(on=Run(), mode=Speaking(), pattern=Args($a, $b), becomes=Paragraph($a, " ", Args($b)))

// Putting into and taking out of a holder.
Reading(on=Store(), mode=Speaking(), pattern=Store($h, $x), becomes=Paragraph("add ", $x, " to ", $h))
Reading(on=Remove(), mode=Speaking(), pattern=Remove($h, $x), becomes=Paragraph("remove ", $x, " from ", $h))

// A set is a list when it is long, a phrase when it is short.
Reading(on=Every(), mode=Speaking(), pattern=Every($k), becomes=Paragraph("every ", $k))
Reading(on=List(), mode=Speaking(), pattern=And($a, $b), becomes=Paragraph($a, " and ", $b))
Reading(on=List(), mode=Speaking(), pattern=And($a, And($b, $c)), becomes=Paragraph($a, ", ", And($b, $c)))
Reading(on=List(), mode=Speaking(), pattern=Or($a, $b), becomes=Paragraph($a, " or ", $b))
Reading(on=Not(), mode=Speaking(), pattern=Not($a), becomes=Paragraph("not ", $a))
Reading(on=Speaker(), mode=Speaking(), pattern=Speaker(), becomes="you")
Reading(on=Addressee(), mode=Speaking(), pattern=Addressee(), becomes="I")
// What is the user's ("my list") is, said back to them, theirs.
Reading(on=My(), mode=Speaking(), pattern=My($n), becomes=Paragraph("your ", $n))
// X is Y; X has Y.
Reading(on=Be(), mode=Speaking(), pattern=Be($x, $y), becomes=Paragraph($x, " is ", $y))
Reading(on=Have(), mode=Speaking(), pattern=Have($x, $y), becomes=Paragraph($x, " has ", $y))

// =============================================================================================
// 2. Honest when stuck, one per reason (design section 23)

Reading(on=NoSense(), mode=Speaking(), pattern=NoSense($w),
  becomes=Paragraph("I don't know what ", Code($w), " means here."))
Reading(on=NoSense(), mode=Speaking(), pattern=NoSense(And($a, $b)),
  becomes=Paragraph("I don't know these words yet: ", And($a, $b), "."))
Reading(on=NoSense(), mode=Speaking(), pattern=NoSense($w, in=$x),
  becomes=Paragraph("I don't know what ", Code($w), " means in ", $x, "."))
Reading(on=NoReading(), mode=Speaking(), pattern=NoReading($x),
  becomes=Paragraph("I understood ", $x, ", but I don't know how to do it."))
Reading(on=NeedUnmet(), mode=Speaking(), pattern=NeedUnmet($n),
  becomes=Paragraph("I can't do that yet: I need to know ", $n, "."))
Reading(on=NeedUnmet(), mode=Speaking(), pattern=NeedUnmet($n, for=$a),
  becomes=Paragraph("To ", $a, ", I need to know ", $n, "."))
Reading(on=NoSource(), mode=Speaking(), pattern=NoSource($q),
  becomes=Paragraph("I don't know ", $q, ", and I have nowhere to look it up."))
Reading(on=NoPermission(), mode=Speaking(), pattern=NoPermission($a),
  becomes=Paragraph("I'm not allowed to ", $a, " without you saying so."))
Reading(on=TooClose(), mode=Speaking(), pattern=TooClose($a, $b),
  becomes=Paragraph("Do you mean ", $a, ", or ", $b, "?"))
Reading(on=BlockedBy(), mode=Speaking(), pattern=BlockedBy($a, $rule, from=$src),
  becomes=Paragraph("I didn't ", $a, ": ", $rule, " (", $src, ")."))
Reading(on=Unworked(), mode=Speaking(), pattern=Unworked($x),
  becomes=Paragraph("I couldn't work out \"", $x, "\"."))
Reading(on=Unworked(), mode=Speaking(), pattern=Unworked($x, because=$why),
  becomes=Paragraph("I couldn't work out \"", $x, "\". ", $why))
Reading(on=Unworked(), mode=Speaking(), pattern=Unworked($x, because=NeedUnmet(Proposal())),
  becomes=Paragraph("There's nothing I'm waiting to do."))
// A question about someone in the conversation the graph holds nothing on.
Reading(on=Unworked(), mode=Speaking(), pattern=Unworked($x, because=NoSource($q, about=$w)), becomes=NoSource($q, about=$w))
Reading(on=NoSource(), mode=Speaking(), pattern=NoSource($q, about=Self()), becomes=Paragraph("I don't know that about myself."))
Reading(on=NoSource(), mode=Speaking(), pattern=NoSource($q, about=User()), becomes=Paragraph("You haven't told me that."))

// =============================================================================================
// 3. Offers before a guarded act, with the target shown (design section 13)

Reading(on=Offer(), mode=Speaking(), pattern=Offer($a),
  becomes=Paragraph("I can ", $a, ". Go ahead?"))
Reading(on=Offer(), mode=Speaking(), pattern=Offer($a, target=$t),
  becomes=Document(Paragraph("I can ", $a, ":"), List($t), Paragraph("Go ahead?")))
Reading(on=Offer(), mode=Speaking(), pattern=Offer($a, effects=UnknownEffects()),
  becomes=Paragraph("I can ", $a, ", but I don't know yet what it changes. Go ahead?"))
Reading(on=Offer(), mode=Speaking(), pattern=Offer(Sequence($a, $b)),
  becomes=Document(Paragraph("I can do these, in order:"), List($a, $b), Paragraph("Go ahead?")))
Reading(on=List(), mode=Speaking(), pattern=List($a, Sequence($b, $c)), becomes=List($a, $b, $c))

// Teaching: the echo before a taught rewrite is kept, and what it says after.
Reading(on=Offer(), mode=Speaking(), pattern=Offer(Remember(Rewrite($w, $d))),
  becomes=Paragraph("So when you say \"", $w, "\", you mean \"", $d, "\"? I'll remember it if so."))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Remember(Rewrite($w, $d)), result=$r, checked=true),
  becomes=Paragraph("Got it: \"", $w, "\" means \"", $d, "\"."))
// A fact about the user kept: said back, as what it now says of their things.
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Remember($p), result=Remembered($f, $c), checked=true),
  becomes=Paragraph("Got it: ", $c, "."))

// =============================================================================================
// 4. Echoes of what it heard

// The echo of a rule it was given (design section 19).
Reading(on=Constraint(), mode=Speaking(), pattern=Echo(Constraint(Not($a))),
  becomes=Paragraph("Got it: I won't ", $a, "."))
Reading(on=Constraint(), mode=Speaking(), pattern=Echo(Constraint(Not($a), until=Told())),
  becomes=Paragraph("Got it: I won't ", $a, " until you say so."))
Reading(on=Constraint(), mode=Speaking(), pattern=Echo(Constraint(Only($a))),
  becomes=Paragraph("Got it: I'll only ", $a, "."))
Reading(on=Constraint(), mode=Speaking(), pattern=Echo(Constraint($r, over=Always())),
  becomes=Paragraph("From now on, ", Echo(Constraint($r)), " Right?"))
// A directive to do a blocked act: the rule is echoed, not lifted (logical-form.md section 7).
Reading(on=Constraint(), mode=Speaking(), pattern=Echo(BlockedBy($a, Constraint(Not($r), until=Told()))),
  becomes=Paragraph("You said not to ", $r, " yet. Do it now?"))
Reading(on=Constraint(), mode=Speaking(), pattern=Echo(BlockedBy($a, Constraint(Not($r)))),
  becomes=Paragraph("You said not to ", $r, ", so I didn't."))
Reading(on=Constraint(), mode=Speaking(), pattern=Echo(BlockedBy($a, Constraint(Only($r)))),
  becomes=Paragraph("You said to only ", $r, ", so I didn't ", $a, "."))

// What it understood a request as, when it asks to be sure.
Reading(on=Directive(), mode=Speaking(), pattern=Echo(Directive($a)),
  becomes=Paragraph("You want me to ", $a, "?"))

// =============================================================================================
// 5. Results. Outcome(act, result=r, checked=c) is what an act did; an act is said in the words
// the user used for it where there are some.

// What an act gave says itself where it has words of its own (a command's run, a file); else
// the outcome says the act was done.
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome($a, result=$r),
  becomes=Either($r, Paragraph("Done: ", $a, ".")))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome($a, result=$r, checked=true),
  becomes=Either($r, Paragraph("Done, and checked: ", $a, ".")))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome($a, result=$r, checked=false),
  becomes=Either($r, Paragraph("I tried to ", $a, ", but it didn't do what it should have.")))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome($a, error=$e),
  becomes=Paragraph("I couldn't ", $a, ": ", $e))
// What a command gave says itself: its command line and what it printed, or that it failed, with
// what it said (exit 0 is success; any other exit, a failure).
Reading(on=Ran(), mode=Speaking(), pattern=Ran($p, $args, exit=0, output=$out),
  becomes=Document(CodeBlock(CommandLine($p, $args)), CodeBlock($out)))
Reading(on=Ran(), mode=Speaking(), pattern=Ran($p, $args, exit=0),
  becomes=Paragraph("Ran ", Code(CommandLine($p, $args)), "."))
Reading(on=Ran(), mode=Speaking(), pattern=Ran($p, $args, exit=$x),
  becomes=Paragraph(Code(CommandLine($p, $args)), " failed (exit ", $x, ")."))
Reading(on=Ran(), mode=Speaking(), pattern=Ran($p, $args, exit=$x, output=$out),
  becomes=Document(Paragraph(Code(CommandLine($p, $args)), " failed (exit ", $x, "):"), CodeBlock($out)))
Reading(on=Ran(), mode=Speaking(), pattern=Ran($p, $args, exit=$x, error=$err),
  becomes=Document(Paragraph(Code(CommandLine($p, $args)), " failed (exit ", $x, "):"), CodeBlock($err)))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Read($x), result=File(path=$path, content=$b, media=$m)),
  becomes=Document(Paragraph(Code($path), ":"), CodeBlock($b)))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Read($x), result=$r),
  becomes=Paragraph($r))
// Holding in the graph: what was put in or taken out of a holder, and what a holder holds or what a
// thing is, said of the thing the way the user said it ("your shopping list").
Reading(on=Store(), mode=Speaking(), pattern=Outcome(Store($h, $x), result=Have($t, $y), checked=true),
  becomes=Paragraph("Added ", $x, " to ", $t, "."))
Reading(on=Remove(), mode=Speaking(), pattern=Outcome(Remove($h, $x), result=Have($t, $y), checked=true),
  becomes=Paragraph("Removed ", $x, " from ", $t, "."))
Reading(on=Remove(), mode=Speaking(), pattern=Outcome(Remove($h, $x), result=Have($t), checked=true),
  becomes=Paragraph("Removed ", $x, " from ", $t, "."))
Reading(on=Have(), mode=Speaking(), pattern=Outcome(Read($x), result=Have($t, $y)), needs=Fact($t, Said(My($n))),
  becomes=Paragraph("Your ", $n, " has ", $y, "."))
Reading(on=Have(), mode=Speaking(), pattern=Outcome(Read($x), result=Have($t, $y)),
  becomes=Paragraph(Have($t, $y), "."))
Reading(on=Have(), mode=Speaking(), pattern=Outcome(Read($x), result=Have($t)), needs=Fact($t, Said(My($n))),
  becomes=Paragraph("Your ", $n, " is empty."))
Reading(on=Have(), mode=Speaking(), pattern=Outcome(Read($x), result=Have($t)),
  becomes=Paragraph($t, " is empty."))
Reading(on=Be(), mode=Speaking(), pattern=Outcome(Read($x), result=Be($t, $y)), needs=Fact($t, Said(My($n))),
  becomes=Paragraph("Your ", $n, " is ", $y, "."))
Reading(on=Be(), mode=Speaking(), pattern=Outcome(Read($x), result=Be($t, $y)),
  becomes=Paragraph(Be($t, $y), "."))
// A folder is said as a list of what is in it, folders marked with a slash; asked where it is
// ("where are we"), its place on the machine.
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Read($x), result=$r, checked=true), wants=IsA($r, Directory()), becomes=$r)
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question(Read($x), about=$k), result=$r, checked=true), wants=All(IsA($k, Place()), IsA($r, Directory())),
  needs=WithRoles($r, location=$l), becomes=Paragraph("We're in ", Code($l), "."))
Reading(on=Directory(), mode=Speaking(), pattern=Directory(path=$p), becomes=Paragraph("There's nothing in ", Code($p), "."))
Reading(on=Directory(), mode=Speaking(), pattern=Directory($e), becomes=List($e))
Reading(on=Directory(), mode=Speaking(), pattern=Directory($e, $f), becomes=List($e, $f))
Reading(on=Entry(), mode=Speaking(), pattern=Entry($n, kind=File()), becomes=Code($n))
Reading(on=Entry(), mode=Speaking(), pattern=Entry($n, kind=Directory()), becomes=Code(Paragraph($n, "/")))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Count($s), result=$n),
  becomes=Paragraph($n))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Outcome(Arithmetic($o, $a, $b), result=$r),
  becomes=Paragraph(Arithmetic($o, $a, $b), " is ", $r, "."))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Outcome(Arithmetic($o, $a, $b), error=$e),
  becomes=Paragraph("I couldn't work out ", Arithmetic($o, $a, $b), ": ", $e, "."))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Addition(), $a, $b), becomes=Paragraph($a, " plus ", $b))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Subtraction(), $a, $b), becomes=Paragraph($a, " minus ", $b))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Subtraction(), 0, $b), becomes=Paragraph("minus ", $b))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Multiplication(), $a, $b), becomes=Paragraph($a, " times ", $b))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Division(), $a, $b), becomes=Paragraph($a, " divided by ", $b))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Exponentiation(), $a, $b), becomes=Paragraph($a, " to the power of ", $b))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Modulo(), $a, $b), becomes=Paragraph($a, " mod ", $b))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Exponentiation(), $a, 2), becomes=Paragraph($a, " squared"))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Exponentiation(), $a, 3), becomes=Paragraph($a, " cubed"))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Exponentiation(), $a, 0.5), becomes=Paragraph("the square root of ", $a))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Exponentiation(), $a, Arithmetic(Division(), 1, 3)), becomes=Paragraph("the cube root of ", $a))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Division(), $a, 100), becomes=Paragraph($a, "%"))
Reading(on=Arithmetic(), mode=Speaking(), pattern=Arithmetic(Multiplication(), Arithmetic(Division(), $a, 100), $b), becomes=Paragraph($a, "% of ", $b))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Undo($a)),
  becomes=Paragraph("I can undo ", $a, ". Want me to?"))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Sequence($steps), stopped=$at),
  becomes=Document(Paragraph("I stopped at ", $at, ". What ran:"), List($steps)))

// Answers from outside: the source named and linked, then its own words (design section 25:
// research names its sources).
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p), result=Found($b, title=$t, to=$u, from=$src)),
  becomes=Document(Paragraph("From ", $src, ", ", Link($t, to=$u), ":"), Paragraph($b)))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p, about=$x), result=Found($b, title=$t, to=$u, from=$src)),
  becomes=Document(Paragraph("From ", $src, ", ", Link($t, to=$u), ":"), Paragraph($b)))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Read($x), result=Page(path=$u, title=$t, content=$b)),
  becomes=Document(Paragraph(Link($t, to=$u), ":"), Paragraph($b)))
// An answer from a tool's own documentation on this machine: the manual page named, its words.
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p), result=Found($b, from=$src)),
  becomes=Document(Paragraph("From ", $src, ":"), Paragraph($b)))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p, about=$x), result=Found($b, from=$src)),
  becomes=Document(Paragraph("From ", $src, ":"), Paragraph($b)))
Reading(on=ToolDoc(), mode=Speaking(), pattern=ToolDoc($page, $part), becomes=Paragraph("the manual page ", Code($page)))
Reading(on=Wikipedia(), mode=Speaking(), pattern=Wikipedia(), becomes="Wikipedia")
Reading(on=Wiktionary(), mode=Speaking(), pattern=Wiktionary(), becomes="Wiktionary")
Reading(on=Wikidata(), mode=Speaking(), pattern=Wikidata(), becomes="Wikidata")
Reading(on=Web(), mode=Speaking(), pattern=Web(), becomes="the web")
Reading(on=Offer(), mode=Speaking(), pattern=Offer(Know($q)),
  becomes=Paragraph("I don't know that. I can look it up online. Go ahead?"))

// The time and the date (Now gives a moment as numbers; the words are these). A day is said with
// its weekday and its date, a time of day on the twelve-hour clock.
Reading(on=Now(), mode=Speaking(), pattern=Outcome(Question(Now(), about=$k), result=At($t, year=$y, month=$mo, day=$d, weekday=$w, hour=$h, minute=$mi)),
  wants=IsA($k, Day()), becomes=Paragraph("Today is ", Weekday($w), ", ", Month($mo), " ", $d, "."))
Reading(on=Now(), mode=Speaking(), pattern=Outcome(Question(Now(), about=$k), result=At($t, year=$y, month=$mo, day=$d, weekday=$w, hour=$h, minute=$mi)),
  becomes=Paragraph("It's ", ClockTime($h, $mi), "."))
Reading(on=Weekday(), mode=Speaking(), pattern=Weekday(1), becomes="Monday")
Reading(on=Weekday(), mode=Speaking(), pattern=Weekday(2), becomes="Tuesday")
Reading(on=Weekday(), mode=Speaking(), pattern=Weekday(3), becomes="Wednesday")
Reading(on=Weekday(), mode=Speaking(), pattern=Weekday(4), becomes="Thursday")
Reading(on=Weekday(), mode=Speaking(), pattern=Weekday(5), becomes="Friday")
Reading(on=Weekday(), mode=Speaking(), pattern=Weekday(6), becomes="Saturday")
Reading(on=Weekday(), mode=Speaking(), pattern=Weekday(7), becomes="Sunday")
Reading(on=Month(), mode=Speaking(), pattern=Month(1), becomes="January")
Reading(on=Month(), mode=Speaking(), pattern=Month(2), becomes="February")
Reading(on=Month(), mode=Speaking(), pattern=Month(3), becomes="March")
Reading(on=Month(), mode=Speaking(), pattern=Month(4), becomes="April")
Reading(on=Month(), mode=Speaking(), pattern=Month(5), becomes="May")
Reading(on=Month(), mode=Speaking(), pattern=Month(6), becomes="June")
Reading(on=Month(), mode=Speaking(), pattern=Month(7), becomes="July")
Reading(on=Month(), mode=Speaking(), pattern=Month(8), becomes="August")
Reading(on=Month(), mode=Speaking(), pattern=Month(9), becomes="September")
Reading(on=Month(), mode=Speaking(), pattern=Month(10), becomes="October")
Reading(on=Month(), mode=Speaking(), pattern=Month(11), becomes="November")
Reading(on=Month(), mode=Speaking(), pattern=Month(12), becomes="December")
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(0, $m), becomes=Paragraph("12:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(1, $m), becomes=Paragraph("1:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(2, $m), becomes=Paragraph("2:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(3, $m), becomes=Paragraph("3:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(4, $m), becomes=Paragraph("4:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(5, $m), becomes=Paragraph("5:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(6, $m), becomes=Paragraph("6:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(7, $m), becomes=Paragraph("7:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(8, $m), becomes=Paragraph("8:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(9, $m), becomes=Paragraph("9:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(10, $m), becomes=Paragraph("10:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(11, $m), becomes=Paragraph("11:", Digits($m, 2), " AM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(12, $m), becomes=Paragraph("12:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(13, $m), becomes=Paragraph("1:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(14, $m), becomes=Paragraph("2:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(15, $m), becomes=Paragraph("3:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(16, $m), becomes=Paragraph("4:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(17, $m), becomes=Paragraph("5:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(18, $m), becomes=Paragraph("6:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(19, $m), becomes=Paragraph("7:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(20, $m), becomes=Paragraph("8:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(21, $m), becomes=Paragraph("9:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(22, $m), becomes=Paragraph("10:", Digits($m, 2), " PM"))
Reading(on=ClockTime(), mode=Speaking(), pattern=ClockTime(23, $m), becomes=Paragraph("11:", Digits($m, 2), " PM"))
// Reminders (Schedule): what will be said, when; said once its time has come; the list of them.
// When is said from the moment it was worked out to: today, tomorrow, or its date.
Reading(on=Schedule(), mode=Speaking(), pattern=Outcome(Schedule($t, $a), result=Scheduled(Say(Quote($w)), at=$m, item=$i), checked=true),
  becomes=Paragraph("I'll remind you ", When($m), " to ", $w, "."))
Reading(on=Schedule(), mode=Speaking(), pattern=Outcome(Schedule($t, $a), result=Scheduled(Say(Quote($w)), at=$m, on=$d, item=$i), checked=true),
  becomes=Paragraph("I'll remind you ", When($m, on=$d), " to ", $w, "."))
Reading(on=Schedule(), mode=Speaking(), pattern=Due(Say(Quote($w))), becomes=Paragraph("Reminder: ", $w, "."))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Read($x), result=$r, checked=true), wants=IsA($r, Schedule()), becomes=$r)
Reading(on=Schedule(), mode=Speaking(), pattern=Schedule(), becomes=Paragraph("There's nothing I'm going to remind you of."))
Reading(on=Schedule(), mode=Speaking(), pattern=Schedule($a), becomes=List($a))
Reading(on=Schedule(), mode=Speaking(), pattern=Schedule($a, $b), becomes=List($a, $b))
Reading(on=Schedule(), mode=Speaking(), pattern=Scheduled(Say(Quote($w)), at=$m), becomes=Paragraph($w, ", ", When($m)))
Reading(on=Schedule(), mode=Speaking(), pattern=Scheduled(Say(Quote($w)), at=$m, on=$d), becomes=Paragraph($w, ", ", When($m, on=$d)))
Reading(on=Now(), mode=Speaking(), pattern=When(At($t, year=$y, month=$mo, day=$d, weekday=$w, hour=$h, minute=$mi), on=0),
  becomes=Paragraph("at ", ClockTime($h, $mi)))
Reading(on=Now(), mode=Speaking(), pattern=When(At($t, year=$y, month=$mo, day=$d, weekday=$w, hour=$h, minute=$mi), on=1),
  becomes=Paragraph("tomorrow at ", ClockTime($h, $mi)))
Reading(on=Now(), mode=Speaking(), pattern=When(At($t, year=$y, month=$mo, day=$d, weekday=$w, hour=$h, minute=$mi)),
  becomes=Paragraph("on ", Weekday($w), ", ", Month($mo), " ", $d, " at ", ClockTime($h, $mi)))

// A number said with at least so many digits ("9:05").
Reading(on=Digits(), mode=Speaking(), pattern=Print(Digits($n, $w), medium=$m), becomes=Digits($n, $w))

// Answers to questions and checks of claims.
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p), result=true), becomes=Paragraph("Yes."))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p), result=false), becomes=Paragraph("No."))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p, about=$x), result=$r), becomes=Paragraph($r))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Question($p), result=$r), becomes=Paragraph($r))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Assert($p), result=true), becomes=Paragraph("Yes, that's right."))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Assert($p), result=false), becomes=Paragraph("That's not so."))
Reading(on=Outcome(), mode=Speaking(), pattern=Outcome(Nothing()), becomes=Paragraph("Nothing."))
// Answers about someone in the conversation, from what the graph holds about them.
Reading(on=State(), mode=Speaking(), pattern=Outcome($q, result=State(Self(), $s)), becomes=Paragraph("I'm ", $s, ", thanks."))
Reading(on=Name(), mode=Speaking(), pattern=Outcome($q, result=Name(Self(), $n)), becomes=Paragraph("I'm ", $n, "."))
Reading(on=Name(), mode=Speaking(), pattern=Outcome($q, result=Name(User(), $n)), becomes=Paragraph("Your name is ", $n, "."))

// Asking.
Reading(on=Ask(), mode=Speaking(), pattern=Ask(Or($a, $b)), becomes=Paragraph("Do you mean ", $a, " or ", $b, "?"))
Reading(on=Ask(), mode=Speaking(), pattern=Ask(Gap(), kind=$k), becomes=Paragraph("Which ", $k, "?"))
Reading(on=Ask(), mode=Speaking(), pattern=Ask($p), becomes=Paragraph($p, "?"))

// Social turns: a greeting or thanks gets a short reply and nothing runs.
Reading(on=Hello(), mode=Speaking(), pattern=Reply(Hello()), becomes=Paragraph("Hi."))
Reading(on=Thanks(), mode=Speaking(), pattern=Reply(Thanks()), becomes=Paragraph("You're welcome."))
Reading(on=Bye(), mode=Speaking(), pattern=Reply(Bye()), becomes=Paragraph("Bye."))

Reading(on=Sorry(), mode=Speaking(), pattern=Reply(Sorry()), becomes=Paragraph("No worries."))
Reading(on=Stop(), mode=Speaking(), pattern=Reply(End($x)), becomes=Paragraph("Stopped."))
Reading(on=Lol(), mode=Speaking(), pattern=Reply(Lol()), becomes=Paragraph("Ha."))

// =============================================================================================
// 6. Markdown (design section 25b)

// The chat prints in markdown; a destination's medium is a fact on it, never a guess.
Fact(Conversation(), Medium(Markdown()))

Concept(Markdown(), IsA(Medium()),
  Escapes("\\"), Escapes("*"), Escapes("_"), Escapes("~"), Escapes("`"), Escapes("#"), Escapes(">"),
  Escapes("["), Escapes("]"), Escapes("<"), Escapes("|"))

Reading(on=Document(), mode=Speaking(), pattern=Print(Document($a, $b), medium=Markdown()),
  becomes=Printed(Print($a, medium=Markdown()), "\n\n", Print($b, medium=Markdown())))
Reading(on=Paragraph(), mode=Speaking(), pattern=Print(Paragraph($x), medium=Markdown()),
  becomes=Print($x, medium=Markdown()))
Reading(on=Paragraph(), mode=Speaking(), pattern=Print(Paragraph($a, $b), medium=Markdown()),
  becomes=Printed(Print($a, medium=Markdown()), Print($b, medium=Markdown())))
Reading(on=Heading(), mode=Speaking(), pattern=Print(Heading($x, level=$n), medium=Markdown()),
  becomes=Printed(Repeated("#", $n), " ", Print($x, medium=Markdown())))
Reading(on=List(), mode=Speaking(), pattern=Print(List($x), medium=Markdown()),
  becomes=Print(Item($x), medium=Markdown()))
Reading(on=List(), mode=Speaking(), pattern=Print(List($a, List($b, $c)), medium=Markdown()),
  becomes=Printed(Print(Item($a), medium=Markdown()), "\n", Print(List($b, $c), medium=Markdown())))
Reading(on=List(), mode=Speaking(), pattern=Print(List($a, $b), medium=Markdown()),
  becomes=Printed(Print(Item($a), medium=Markdown()), "\n", Print(List($b), medium=Markdown())))
Reading(on=Item(), mode=Speaking(), pattern=Print(Item(Item($x)), medium=Markdown()),
  becomes=Print(Item($x), medium=Markdown()))
Reading(on=Item(), mode=Speaking(), pattern=Print(Item($x), medium=Markdown()),
  becomes=Printed("- ", Print($x, medium=Markdown())))
Reading(on=Task(), mode=Speaking(), pattern=Print(Task($x, done=false), medium=Markdown()),
  becomes=Printed("- [ ] ", Print($x, medium=Markdown())))
Reading(on=Task(), mode=Speaking(), pattern=Print(Task($x, done=true), medium=Markdown()),
  becomes=Printed("- [x] ", Print($x, medium=Markdown())))
Reading(on=Contrast(), mode=Speaking(), pattern=Print(Contrast($x), medium=Markdown()),
  becomes=Printed("*", Print($x, medium=Markdown()), "*"))
Reading(on=Important(), mode=Speaking(), pattern=Print(Important($x), medium=Markdown()),
  becomes=Printed("**", Print($x, medium=Markdown()), "**"))
Reading(on=Important(), mode=Speaking(), pattern=Print(Important(Contrast($x)), medium=Markdown()),
  becomes=Printed("***", Print($x, medium=Markdown()), "***"))
Reading(on=Withdrawn(), mode=Speaking(), pattern=Print(Withdrawn($x), medium=Markdown()),
  becomes=Printed("~~", Print($x, medium=Markdown()), "~~"))
Reading(on=Inserted(), mode=Speaking(), pattern=Print(Inserted($x), medium=Markdown()),
  becomes=Printed("<ins>", Print($x, medium=Markdown()), "</ins>"))
Reading(on=Quote(), mode=Speaking(), pattern=Print(Quote($x), medium=Markdown()),
  becomes=Printed("> ", Print($x, medium=Markdown())))
Reading(on=Callout(), mode=Speaking(), pattern=Print(Callout($x, kind=$k), medium=Markdown()),
  becomes=Printed("> [!", Uppercase($k), "]\n> ", Print($x, medium=Markdown())))
// Code shows source, never rendering: inline code uses enough backticks, a block a long enough fence.
Reading(on=Code(), mode=Speaking(), pattern=Print(Code($x), medium=Markdown()),
  becomes=Fenced($x, mark="`", min=1, pad=true))
Reading(on=CodeBlock(), mode=Speaking(), pattern=Print(CodeBlock($x), medium=Markdown()),
  becomes=Fenced($x, mark="`", min=3, block=true))
Reading(on=CodeBlock(), mode=Speaking(), pattern=Print(CodeBlock($x, language=$l), medium=Markdown()),
  becomes=Fenced($x, mark="`", min=3, block=true, language=$l))
Reading(on=Link(), mode=Speaking(), pattern=Print(Link($x, to=$t), medium=Markdown()),
  becomes=Printed("[", Print($x, medium=Markdown()), "](", $t, ")"))
// A link whose text is its target prints the bare target.
Reading(on=Link(), mode=Speaking(), pattern=Print(Link($t, to=$t), medium=Markdown()), becomes=$t)
Reading(on=Image(), mode=Speaking(), pattern=Print(Image($src, alt=$a), medium=Markdown()),
  becomes=Printed("![", Escaped($a, medium=Markdown()), "](", $src, ")"))
Reading(on=Note(), mode=Speaking(), pattern=Print(Note($x, $n), medium=Markdown()),
  becomes=Printed("[^", $n, "]: ", Print($x, medium=Markdown())))
Reading(on=LineBreak(), mode=Speaking(), pattern=Print(LineBreak(), medium=Markdown()), becomes="  \n")

// =============================================================================================
// 7. Plain text (design section 25b). Stress prints nothing: the words carry it.

Concept(PlainText(), IsA(Medium()))

Reading(on=Document(), mode=Speaking(), pattern=Print(Document($a, $b), medium=PlainText()),
  becomes=Printed(Print($a, medium=PlainText()), "\n\n", Print($b, medium=PlainText())))
Reading(on=Paragraph(), mode=Speaking(), pattern=Print(Paragraph($a, $b), medium=PlainText()),
  becomes=Printed(Print($a, medium=PlainText()), Print($b, medium=PlainText())))
Reading(on=Heading(), mode=Speaking(), pattern=Print(Heading($x, level=_), medium=PlainText()),
  becomes=Print($x, medium=PlainText()))
Reading(on=Item(), mode=Speaking(), pattern=Print(Item($x), medium=PlainText()),
  becomes=Printed("- ", Print($x, medium=PlainText())))
Reading(on=Task(), mode=Speaking(), pattern=Print(Task($x, done=false), medium=PlainText()),
  becomes=Printed("[ ] ", Print($x, medium=PlainText())))
Reading(on=Task(), mode=Speaking(), pattern=Print(Task($x, done=true), medium=PlainText()),
  becomes=Printed("[x] ", Print($x, medium=PlainText())))
Reading(on=Contrast(), mode=Speaking(), pattern=Print(Contrast($x), medium=PlainText()), becomes=Print($x, medium=PlainText()))
Reading(on=Important(), mode=Speaking(), pattern=Print(Important($x), medium=PlainText()), becomes=Print($x, medium=PlainText()))
Reading(on=Callout(), mode=Speaking(), pattern=Print(Callout($x, kind=$k), medium=PlainText()),
  becomes=Printed(Capitalized($k), ": ", Print($x, medium=PlainText())))
Reading(on=Code(), mode=Speaking(), pattern=Print(Code($x), medium=PlainText()), becomes=$x)
Reading(on=Link(), mode=Speaking(), pattern=Print(Link($x, to=$t), medium=PlainText()),
  becomes=Printed(Print($x, medium=PlainText()), " (", $t, ")"))
